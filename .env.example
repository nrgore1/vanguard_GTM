# ---- Vanguard-GTM configuration -------------------------------------------
# Copy to .env and fill in. .env is git-ignored - never commit it.

# Model provider: "local" (default) = your own model via Ollama, $0; Claude is only a capped backup.
VANGUARD_PROVIDER=local
VANGUARD_LOCAL_MODEL=qwen3.6:27b      # or qwen3.8:27b, qwen3:14b, llama3.1:8b - whatever you `ollama pull`
VANGUARD_LOCAL_API=ollama             # "openai" for LM Studio / llama.cpp / vLLM
#VANGUARD_LOCAL_URL=http://localhost:11434
VANGUARD_LOCAL_CONCURRENCY=1

# $0 BY DEFAULT: paid Claude API runs are OFF while this is 0.
# Dry runs, `vanguard prompt` / `vanguard import` (your Claude chat) and Notion sync cost nothing.
# Set a positive number (e.g. 5) only when you want paid runs; it is a hard cap per run.
VANGUARD_MAX_COST_USD=0

# Claude API key - the backup. Only used when the cap above is > 0. Leave blank for $0 mode.
ANTHROPIC_API_KEY=
VANGUARD_MODEL=claude-sonnet-5        # Claude model for fallback / claude-only runs
VANGUARD_WEB_SEARCH=1                 # 0 = skip Engine 1 web research (cheaper)
VANGUARD_CONCURRENCY=4

# Notion internal connection token (free). See docs/SETUP_NOTION_AND_KEYS.md
NOTION_TOKEN=

# Partner outreach email. "outbox" (default) = approved emails saved to output/outbox, nothing sent.
# "smtp" = really send via your own mailbox (see docs/SETUP_NOTION_AND_KEYS.md Part 7).
# "postmark" = warm partners via Postmark streams, cold first touch via SMTP or held (Part 8).
VANGUARD_EMAIL_MODE=outbox
VANGUARD_SENDER_NAME=
VANGUARD_SENDER_EMAIL=
VANGUARD_SENDER_ADDRESS=
VANGUARD_EMAIL_DAILY_CAP=20
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
VANGUARD_OUTREACH_EVERY_MIN=0

# Postmark (optional; free plan = 100 emails/month). Create a NEW server token for Vanguard.
POSTMARK_SERVER_TOKEN=
VANGUARD_POSTMARK_STREAM_OUTREACH=partners
VANGUARD_POSTMARK_STREAM_NOTIFY=outbound
VANGUARD_POSTMARK_INBOUND_ADDRESS=
VANGUARD_POSTMARK_MONTHLY_CAP=100
VANGUARD_POSTMARK_ALLOW_COLD=0
VANGUARD_POSTMARK_TRACK_OPENS=0
# Basic Auth for the webhook URL https://USER:PASSWORD@your-host/hooks/postmark
VANGUARD_POSTMARK_WEBHOOK_USER=
VANGUARD_POSTMARK_WEBHOOK_PASSWORD=
VANGUARD_NOTIFY_REPLIES=1

# Database. Empty = SQLite file at VANGUARD_DB (default data/vanguard.db).
# docker-compose sets VANGUARD_DATABASE_URL to its own PostgreSQL from VANGUARD_DB_PASSWORD.
#VANGUARD_DATABASE_URL=postgresql://vanguard:PASSWORD@localhost:5432/vanguard
VANGUARD_DB_PASSWORD=
#VANGUARD_CONFIG_DIR=/app/config      # where properties.yaml etc. live (Docker sets this)

# Web app (`vanguard serve`): signs sign-in sessions. Long random string; keep it stable.
VANGUARD_JWT_SECRET=
VANGUARD_SESSION_HOURS=12
# Machine API at /machine (cron / n8n) - long random string
VANGUARD_API_TOKEN=
TRAEFIK_NETWORK=edge
